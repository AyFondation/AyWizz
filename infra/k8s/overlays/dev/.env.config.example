# =============================================================================
# File: .env.config.example
# Version: 5
# Path: infra/k8s/overlays/dev/.env.config.example
#       (copy → .env.config, adjust values)
# Description: TEMPLATE for the dev overlay's NON-SECRET config source. The
#              kustomize configMapGenerator turns this into the `aywizz-config`
#              ConfigMap, injected into every pod via `envFrom`. Copy to
#              `.env.config` (git-ignored) and adjust. Symmetric to
#              `.env.secret.example` — SECRETS live there, NEVER here
#              (CLAUDE.md §4.6 / R-100-118 v2).
#
#              This file is the AUTHORITATIVE, hand-maintained schema of the
#              non-secret keys the platform reads. Every settings class uses
#              `extra="ignore"`, so unknown keys are harmless and most fields
#              have safe in-cluster defaults; the entries below are the ones
#              worth pinning explicitly for a working dev bring-up. Keys whose
#              in-cluster default is already correct are shown commented with
#              their default so the schema stays discoverable.
#
#              Two flags are injected as overlay LITERALS (see
#              kustomization.yaml), NOT here: C2_DEMO_SEED_ENABLED=true and
#              C2_UX_DEV_MODE_ENABLED=true. COMPONENT_MODULE is set per
#              Deployment (the one-image / N-containers discriminator), never
#              in this file.
# =============================================================================

# --- Platform -----------------------------------------------------------------
PLATFORM_ENVIRONMENT=development

# --- ArangoDB (C11) — shared unified store ------------------------------------
# In-cluster service DNS; the password is a SECRET (see .env.secret).
ARANGO_URL=http://arangodb:8529
ARANGO_DB=platform
ARANGO_USERNAME=ay_app

# --- MinIO (C10) — object / artifact store ------------------------------------
# The secret key is a SECRET (see .env.secret).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ay_app
MINIO_SECURE=false
# Per-component buckets have code defaults (orchestrator/requirements/validation/
# memory/llm-archive); the shared artifact bucket used by C8-admin storage
# metering is `orchestrator`.
MINIO_BUCKET=orchestrator

# --- LLM egress (C8) — every component calls the gateway, NEVER a provider ----
# CRITICAL override: the client default is http://c8:8000/v1, but the real
# in-cluster proxy Service is `litellm:4000`. Point clients at it.
C8_GATEWAY_URL=http://litellm:4000/v1
# C8_GATEWAY_API_KEY is a SECRET (shared client credential + litellm master_key)
# — set it in .env.secret. In dev it may be any non-empty placeholder.
#
# MODEL SELECTION IS AUTOMATIC + IN-APP (D-011). The C8 client resolves each
# agent → a CONCRETE model from the operator's registry CATALOGUE, scoped to
# the call's PROJECT, by quality tier. So there is NO model/provider name in
# config: just register a provider + models in the HMI and associate them with
# the project — the platform picks the right one per call. The two knobs below
# are OPTIONAL legacy overrides (leave them UNSET for the in-app behaviour):
# C8_DEFAULT_MODEL=            # force a single model ALIAS for every agent
# C8_AGENT_ROUTES_INLINE=      # JSON {agent: alias} to pin per-agent routing

# --- C3 chat RAG wiring -------------------------------------------------------
# REQUIRED for automatic LLM answers. C3 does chat-with-RAG only when BOTH this
# C7 base URL AND C8_GATEWAY_URL (above) are non-empty; otherwise it saves the
# message and replies with the "RAG / LLM not wired" stub. Point it at the C7
# memory Service (name `c7-memory`, port 8000).
C3_C7_BASE_URL=http://c7-memory:8000
# OPTIONAL — enables the chat-direct DocGen tool loop (D-015): the LLM is
# offered the document tools, executed against C4. Empty → plain RAG chat.
C3_C4_BASE_URL=http://c4-orchestrator:8000

# --- Embeddings (C7) — IN-APP (D-011) -----------------------------------------
# Embedding selection is NOT env-configured. C7's bootstrap fallback is a fixed
# deterministic hash (lexical, no network). Real embedders (the dev-deployed
# Ollama + all-minilm, or an openai-compatible endpoint) are declared in the
# embedding registry via the admin HMI and selected per-project. The dev stack
# still deploys Ollama + the ollama-seed Job so that model is available to
# register.

# --- C2 Auth ------------------------------------------------------------------
# SEMANTIC (§4.6). `local` = username/password against C2's own store (dev
# default); `none` = trust forward-auth headers as-is; `sso` = Entra ID.
C2_AUTH_MODE=local
C2_JWT_ALGORITHM=HS256
# C2_JWT_SECRET_KEY, C2_LOCAL_ADMIN_PASSWORD, C2_LOCAL_PLATFORM_MANAGER_PASSWORD
# are SECRETS — see .env.secret. Usernames are non-secret. The platform_manager
# is bootstrapped only when BOTH its username and password are non-empty:
C2_LOCAL_ADMIN_USERNAME=admin
C2_LOCAL_PLATFORM_MANAGER_USERNAME=platform-manager

# --- C4 Orchestrator ----------------------------------------------------------
# SEMANTIC (§4.6). `in-process` (default) runs sub-agents inside the pod;
# `k8s` fans out to ephemeral pods and REQUIRES the opt-in c4_workers layer
# (kubectl apply -k infra/k8s/base/c4_workers). Keep in-process for dev.
C4_DISPATCHER_BACKEND=in-process
# SEMANTIC (§4.6). `in_process` (default) vs `openhands` V2 generate engine.
C4_GENERATE_ENGINE=in_process
# NATS is only needed by the K8s dispatcher / event bus; harmless otherwise.
# C4_NATS_URL=nats://nats:4222

# --- UI / gateway public origin ----------------------------------------------
# Base URL the UI + C12 webhooks advertise. Matches the dev LoadBalancer.
PUBLIC_BASE_URL=http://localhost:56000

# --- Optional integrations (leave unset unless used) --------------------------
# Gitea (DocGen live-docs versioning). GITEA_ROOT_PASSWORD would be a SECRET.
# C2_GITEA_BASE_URL=http://gitea:3000
# C4_GITEA_BASE_URL=http://gitea:3000
# GITEA_ROOT_USERNAME=gitea_admin
