# =============================================================================
# File: .env.secret.example
# Version: 5
# Path: infra/k8s/overlays/dev/.env.secret   (copy → .env.secret, fill values)
# Description: TEMPLATE for the dev overlay's Tier-2 Secret source. The
#              kustomize secretGenerator hashes this into the `aywizz-secrets`
#              Secret, injected into every pod via `envFrom`. Copy to
#              `.env.secret` (git-ignored) and fill REAL dev values.
#              CLAUDE.md §4.6 / R-100-118 v2. Non-secret config keys live in
#              the symmetric `.env.example`.
#
#              APPLYING A CHANGE: the dev overlay uses stable Secret names, so
#              editing this file does NOT auto-restart pods. Re-apply + reload:
#                infra/k8s/run.sh dev --restart --wait
#
#              Key SET (values omitted) — mirror to system-test/prod overlays
#              with their own values.
#
#              v2: renamed C2_LOCAL_TENANT_MANAGER_PASSWORD →
#              C2_LOCAL_PLATFORM_MANAGER_PASSWORD (the role was renamed
#              tenant_manager → platform_manager; the C2 settings field reads
#              the PLATFORM_MANAGER alias, so the old key was silently ignored).
#              v3 (provider-independence, D-011): REMOVED ANTHROPIC_API_KEY — no
#              provider key lives in env anymore. Added AY_SECRET_MASTER_KEY
#              (encrypts the registry-stored provider keys set via the HMI).
#              v4: added the --restart note (stable Secret names don't rollout).
#              v5: per-key OPERATIONAL docs (what it's for + expected format) +
#              format-EXAMPLE values (`changeme-…`) showing shape/length.
# =============================================================================

# NOTE: every value below is a FORMAT EXAMPLE (`changeme-…`) — it shows the
# expected shape/length. REPLACE each one before any real use.

# --- Data tier: ArangoDB (C11) + MinIO (C10) ----------------------------------
# Superuser passwords, consumed ONLY by the one-shot *-init Jobs to bootstrap
# the DB / object store. Strong, ≥ 16 chars.
ARANGO_ROOT_PASSWORD=changeme-arango-root-Xk29Qm4pR7
MINIO_ROOT_PASSWORD=changeme-minio-root-Zt71Rv8wLc
# Runtime credentials the services present to reach the data tier. The init
# Jobs provision the app user with THESE values — keep them consistent.
ARANGO_PASSWORD=changeme-arango-app-Bn53Lc6hVd
MINIO_SECRET_KEY=changeme-minio-app-Pd92Ws4kTe

# --- C2 Auth ------------------------------------------------------------------
# Secret that SIGNS the platform JWTs (HS256). ≥ 32 chars of entropy; rotating
# it invalidates every live session.
C2_JWT_SECRET_KEY=changeme-jwt-signing-secret-4f8a1c7e2b9d60835e11
# Login password of the seeded local ADMIN (username = C2_LOCAL_ADMIN_USERNAME
# in .env). This is the account you sign in with on first boot.
C2_LOCAL_ADMIN_PASSWORD=changeme-admin-Aa1!pass
# Login password of the seeded super-root (platform_manager). The super-root is
# created ONLY when BOTH this AND C2_LOCAL_PLATFORM_MANAGER_USERNAME (.env) are
# non-empty; leave blank to skip it (the admin alone suffices single-tenant).
C2_LOCAL_PLATFORM_MANAGER_PASSWORD=changeme-superroot-Aa1!pass

# --- Observability (prod workflow synthesis, R-100-124) -----------------------
# Elasticsearch password for the log / synthesis sinks. NOT needed for local
# dev — leave as-is or blank.
OBS_ELASTICSEARCH_PASSWORD=changeme-elastic-prod-only

# C8 — LLM gateway (LiteLLM proxy).
#
#   C8_GATEWAY_API_KEY : the shared gateway credential — every backend component
#     presents it as its Bearer AND the LiteLLM proxy enforces it as its
#     master_key. Pick any strong secret (e.g. `sk-aywizz-<random>`). In dev a
#     placeholder is fine.
#
#   AY_SECRET_MASTER_KEY : the master key that ENCRYPTS the LLM provider API
#     keys stored in the in-app registry (AES-256-GCM). The platform is
#     provider-independent (D-011): there is NO provider key in env — you
#     register a provider + its key in the HMI (/admin/llm-*), and C8 stores it
#     encrypted with this master key + injects it per call.
#     • Format: url-safe base64 of 32 bytes. Generate one with:
#         python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#     • REQUIRED to store provider keys. If ABSENT, the app still boots and you
#       can create a provider, but saving its key is refused (503) and the HMI
#       shows the key as "not set" — this is the #1 gotcha.
C8_GATEWAY_API_KEY=sk-aywizz-changeme-0123456789abcdef0123
AY_SECRET_MASTER_KEY=YXl3aXp6LUVYQU1QTEUtbWFzdGVyLWtleS0zMmJ5dGU=
