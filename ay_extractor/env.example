# =============================================================================
# ayExtractor — .env configuration — v1
# =============================================================================
#
# Single source of truth for:
#   - Application settings (loaded by pydantic-settings via Settings class)
#   - Docker Compose service configuration (variable substitution)
#   - E2E / Integration test infrastructure
#
# Usage:
#   cp .env.example .env    # then edit values
#
# Priority (highest → lowest):
#   1. Environment variables (shell export)
#   2. .env file (this file)
#   3. Settings class defaults (src/config/settings.py)
#
# =============================================================================


# ─── LLM PROVIDERS ──────────────────────────────────────────────────────────

# Default LLM routing (used when no per-phase/per-component override is set)
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=qwen2.5:0.5b
LLM_DEFAULT_TEMPERATURE=0.2
LLM_MAX_TOKENS_PER_AGENT=4096

# Provider API keys (leave empty if not using that provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama endpoint (used by app AND docker-compose for healthchecks)
OLLAMA_BASE_URL=http://localhost:11434

# ─── OPENROUTER (multi-provider gateway) ─────────────────────────────────────
# Docs: https://openrouter.ai/docs
# Model list: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=ayExtractor
OPENROUTER_TEST_MODEL=google/gemma-3-1b-it:free

# Per-phase LLM assignment (format: "provider:model", empty = use default)
#   Example: LLM_PHASE_EXTRACTION=anthropic:claude-sonnet-4-20250514
LLM_PHASE_EXTRACTION=
LLM_PHASE_CHUNKING=
LLM_PHASE_ANALYSIS=
LLM_PHASE_NORMALIZATION=

# Per-component LLM assignment (highest priority, overrides phase & default)
#   Example: LLM_CONCEPT_EXTRACTOR=openai:gpt-4o
LLM_IMAGE_ANALYZER=
LLM_REFERENCE_EXTRACTOR=
LLM_SUMMARIZER=
LLM_DENSIFIER=
LLM_DECONTEXTUALIZER=
LLM_CONCEPT_EXTRACTOR=
LLM_COMMUNITY_SUMMARIZER=
LLM_PROFILE_GENERATOR=
LLM_SYNTHESIZER=
LLM_CRITIC=
LLM_ENTITY_NORMALIZER=
LLM_RELATION_NORMALIZER=


# ─── EMBEDDINGS ─────────────────────────────────────────────────────────────

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
EMBEDDING_ST_MODEL=all-MiniLM-L6-v2


# ─── DOCUMENT LIMITS ────────────────────────────────────────────────────────

MAX_DOCUMENT_SIZE_MB=50
MAX_DOCUMENT_PAGES=2000
MAX_DOCUMENT_TOKENS=500000
OVERSIZE_STRATEGY=reject           # reject | truncate | sample


# ─── CHUNKING ───────────────────────────────────────────────────────────────

CHUNKING_STRATEGY=structural       # structural | semantic
CHUNK_TARGET_SIZE=2000
CHUNK_OVERLAP=0
DECONTEXTUALIZATION_ENABLED=true
DECONTEXTUALIZER_TOOL_USE=auto     # auto | always | never
DECONTEXTUALIZER_TOOL_CONFIDENCE_THRESHOLD=0.7


# ─── PIPELINE ───────────────────────────────────────────────────────────────

DENSITY_ITERATIONS=5
CONFIDENCE_THRESHOLD=0.6
CRITIC_AGENT_ENABLED=false
CRITIC_STRICTNESS=medium           # low | medium | high


# ─── TRIPLET CONSOLIDATION ──────────────────────────────────────────────────

ENTITY_SIMILARITY_THRESHOLD=0.85
RELATION_TAXONOMY_EXTENSIBLE=true
TRIPLET_CONFIDENCE_BOOST=true


# ─── COMMUNITY DETECTION ────────────────────────────────────────────────────

COMMUNITY_DETECTION_RESOLUTION=1.0
COMMUNITY_DETECTION_SEED=42
COMMUNITY_MIN_SIZE=3
COMMUNITY_SUMMARY_ENABLED=true


# ─── ENTITY / RELATION PROFILES ─────────────────────────────────────────────

PROFILE_GENERATION_ENABLED=true
PROFILE_MIN_RELATIONS=2


# ─── SCORING WEIGHTS (RAG composite) ────────────────────────────────────────

SCORING_W_CONFIDENCE=0.3
SCORING_W_SALIENCE=0.3
SCORING_W_FRESHNESS=0.2
SCORING_W_CORROBORATION=0.2
SCORING_CORROBORATION_CAP=5


# ─── CHUNK OUTPUT MODE ──────────────────────────────────────────────────────

CHUNK_OUTPUT_MODE=files_only
# files_only | files_and_vectordb | files_and_graphdb | files_and_both_db


# ─── CACHE ──────────────────────────────────────────────────────────────────

CACHE_ENABLED=true
CACHE_BACKEND=json                 # json | sqlite | redis | arangodb
CACHE_ROOT=~/.ayextractor/cache
CACHE_REDIS_URL=
CACHE_ARANGODB_URL=
CACHE_ARANGODB_DATABASE=ayextractor_cache
SIMHASH_THRESHOLD=3
MINHASH_THRESHOLD=0.8
CONSTELLATION_THRESHOLD=0.7


# ─── OUTPUT STORAGE ─────────────────────────────────────────────────────────

OUTPUT_WRITER=local                # local | s3
OUTPUT_S3_BUCKET=
OUTPUT_S3_PREFIX=ayextractor/
OUTPUT_S3_REGION=
OUTPUT_FORMAT=both                 # markdown | json | both


# ─── GRAPH EXPORT ───────────────────────────────────────────────────────────

GRAPH_EXPORT_FORMATS=graphml       # comma-separated: graphml,gexf,json


# ─── BATCH SCAN ─────────────────────────────────────────────────────────────

BATCH_SCAN_ENABLED=false
BATCH_SCAN_ROOT=
BATCH_SCAN_RECURSIVE=true
BATCH_SCAN_FORMATS=pdf,epub,docx,md,txt,png,jpg,jpeg,webp


# ─── LOGGING ────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | text
LOG_FILE=~/.ayextractor/logs/analyzer.log
LOG_ROTATION=10MB
LOG_RETENTION=30


# ─── VECTOR DATABASE ────────────────────────────────────────────────────────

VECTOR_DB_TYPE=none                # none | chromadb | qdrant | arangodb
VECTOR_DB_PATH=~/.ayextractor/vectordb
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=ayextractor


# ─── GRAPH DATABASE ─────────────────────────────────────────────────────────

GRAPH_DB_TYPE=none                 # none | neo4j | arangodb
GRAPH_DB_URI=bolt://localhost:7687
GRAPH_DB_DATABASE=ayextractor
GRAPH_DB_USER=
GRAPH_DB_PASSWORD=
GRAPH_DB_MERGE_STRATEGY=incremental  # incremental | replace


# ─── RAG ────────────────────────────────────────────────────────────────────

RAG_ENABLED=false
RAG_ENRICH_AGENTS=decontextualizer,concept_extractor,reference_extractor,synthesizer
RAG_RETRIEVAL_TOP_K_COMMUNITIES=5
RAG_RETRIEVAL_TOP_K_ENTITIES=20
RAG_RETRIEVAL_TOP_K_CHUNKS=10
RAG_CHUNK_FALLBACK_THRESHOLD=0.6
RAG_COMPOSITE_WEIGHT=0.3
RAG_PPR_ALPHA=0.15
RAG_CONTEXT_TOKEN_BUDGET=4000
RAG_INCLUDE_CORPUS_GRAPH=true


# ─── CONSOLIDATOR ───────────────────────────────────────────────────────────

CONSOLIDATOR_ENABLED=false
CONSOLIDATOR_TRIGGER=on_ingestion  # on_ingestion | scheduled | manual
CONSOLIDATOR_SCHEDULE=0 3 * * 0
CONSOLIDATOR_PASSES=linking,clustering,inference,decay,contradiction
CONSOLIDATOR_DECAY_HALFLIFE_DAYS=90
CONSOLIDATOR_INFERENCE_MIN_CONFIDENCE=0.6
CONSOLIDATOR_INFERENCE_DISCOUNT=0.8
CONSOLIDATOR_PRUNE_THRESHOLD=0.2
CONSOLIDATOR_CLUSTER_MIN_SIZE=3


# ─── GPU ACCELERATION (optional) ────────────────────────────────────────────

GPU_CLUSTERING_BACKEND=sklearn     # sklearn | cuml
GPU_SIMILARITY_BACKEND=sklearn     # sklearn | cupy | torch


# =============================================================================
# DOCKER COMPOSE — Infrastructure services
# =============================================================================
# These vars are used by docker-compose.e2e.yml and
# docker-compose.integration.yml via ${VAR} substitution.
# They are NOT read by the Settings class (no matching field).

# ─── Ollama (docker-compose) ────────────────────────────────────────────────

OLLAMA_LLM_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── ArangoDB (docker-compose) ──────────────────────────────────────────────

ARANGODB_ROOT_PASSWORD=testpassword
ARANGODB_TEST_DATABASE=ayextractor_test

# ─── Qdrant (docker-compose) ────────────────────────────────────────────────

QDRANT_IMAGE_TAG=v1.13.2

# ─── ChromaDB (docker-compose) ──────────────────────────────────────────────

CHROMADB_IMAGE_TAG=1.5.0
