{
  "_comment": "Structural assertions for chunking output",
  "min_chunk_count": 2,
  "max_chunk_count": 20,
  "every_chunk_must": {
    "min_char_count": 50,
    "has_source_file": true,
    "has_id": true,
    "has_content": true
  },
  "at_least_one_chunk_must_contain": [
    "NIS2 Directive",
    "ENISA",
    "October 2024"
  ],
  "chunks_are_ordered": true,
  "no_duplicate_ids": true
}